PORT=3000
# Postgres connection string (Render, Neon, or local Postgres).
DATABASE_URL=postgres://user:password@host:5432/picante
# Cloudinary (required in production; without these, uploads fall back to local disk — dev only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Used to sign cookies/sessions if needed in future; keep secret.
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
